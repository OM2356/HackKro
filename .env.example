# Server configuration
PORT=3000
APP_URL="http://localhost:3000"

# JWT Authentication Secret (64+ byte cryptographically secure secret)
JWT_SECRET=""

# Resend API for automated email notifications
# Get your free key at https://resend.com
RESEND_API_KEY=""
RESEND_FROM_EMAIL="HackKro Portal <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL="admin@hackkro.com"

# PostgreSQL Database Configuration (Optional external connection)
# If left empty, the server automatically boots an internal PostgreSQL relational engine (pg-mem)
# DATABASE_URL="postgresql://user:password@localhost:5432/hackkro_db"
# PGHOST="localhost"
# PGPORT="5432"
# PGUSER="postgres"
# PGPASSWORD="password"
# PGDATABASE="hackkro_db"

